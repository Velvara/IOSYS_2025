.item-carousel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.carousel-slot {
    width: 56px;
    height: 56px;
    margin-left: 5px;
    margin-right: 5px;
    background-size: contain;
    transition-property: width, height, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.carousel-slot--none {
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/Materials/Textures/UI/Inventory/T_Inv_None.png?fileID=21300000&guid=3636415808b13a2408bfca25258b92a0&type=3#T_Inv_None");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.carousel-slot--center {
    width: 76px;
    height: 76px;
}

.carousel-slot--missing {
    background-color: rgba(64, 64, 64, 0.85);
}

.carousel-name {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 10px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
}

.carousel-badge {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 12px;
    color: white;
    background-color: rgba(0, 0, 0, 0.6);
    padding-left: 3px;
    padding-right: 3px;
    border-top-left-radius: 4px;
    -unity-text-align: middle-center;
}
